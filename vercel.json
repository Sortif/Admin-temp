{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "dist" }
    }
  ],
  "routes": [
    {
      "src": "^/(js|assets|images|fonts|.*\\.(?:js|css|jpg|jpeg|png|gif|ico|svg|webp|webmanifest|json))(?:/.*)?$",
      "headers": { "Cache-Control": "public, max-age=31536000, immutable" }
    },
    {
      "src": "^/sw.js$",
      "headers": { "Cache-Control": "no-cache" }
    },
    {
      "src": "^/(.*)$",
      "dest": "/index.html"
    }
  ],
  "cleanUrls": true,
  "trailingSlash": false
}
