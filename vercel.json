{
  "buildCommand": "npm run build",
  "outputDirectory": "dist/production",
  "framework": null,
  "headers": [
    {
      "source": "/(js|assets|images|fonts)/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache" }
      ]
    }
  ],
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/(?!(?:js|assets|images|fonts|.*\\.(?:js|css|jpg|jpeg|png|gif|ico|svg|webp|webmanifest|json))(/)?)(.+)",
      "destination": "/index.html"
    }
  ]
}
